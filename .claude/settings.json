{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/format-on-edit.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-on-stop.sh",
            "timeout": 600,
            "asyncRewake": true,
            "statusMessage": "Running pre-return checks (cargo + frontend)…",
            "rewakeSummary": "Pre-return checks failed",
            "rewakeMessage": "The Stop hook ran the project check matrix and one or more checks failed. Output:"
          }
        ]
      }
    ]
  }
}
